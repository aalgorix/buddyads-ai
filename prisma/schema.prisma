generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  website   String
  createdAt DateTime @default(now())
  jobs      Job[]

  @@index([email])
}

model Job {
  id           String    @id @default(cuid())
  customerId   String
  status       JobStatus @default(PENDING)
  websiteUrl   String
  /// JSON intake from /check-report (business context for the agent)
  intake       String?
  /// Durable stage outputs: crawl pages, AEO/GEO/technical, prompts, parse, evidence, graph
  pipelineJson String?
  progressStep String?
  error        String?
  agentTrace   String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  report   Report?

  @@index([status])
  @@index([createdAt])
}

model Report {
  id        String   @id @default(cuid())
  jobId     String   @unique
  token     String   @unique
  brandName String
  overall   Int
  aeo       Int
  geo       Int
  llmReady  Int
  grade     String
  summary   String
  payload   String
  /// Absolute path to generated PDF (optional)
  pdfPath   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([token])
}

model EmailLog {
  id         String   @id @default(cuid())
  jobId      String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([jobId])
}
