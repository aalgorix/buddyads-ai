# Local Postgres (docker compose up -d)
# Production: use Railway Postgres DATABASE_URL
DATABASE_URL="postgresql://buddyads:buddyads@localhost:5432/buddyads"

# OpenRouter — multi-model research (used if native keys are missing)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,anthropic/claude-3.5-haiku
OPENROUTER_HTTP_REFERER=https://buddyads.agency
OPENROUTER_APP_TITLE=BuddyAds AI Visibility
# OPENROUTER_ONLY=true  # skip native vendor keys even if set

# Optional native LLM keys (used instead of / alongside OpenRouter)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# Crawl: Playwright when available, otherwise HTTP fetch
RESEARCH_MAX_PAGES=12
RESEARCH_MAX_PROMPTS=8
# RESEARCH_FETCH_ONLY=true

# Resend — verify buddyads.agency domain, then use company from-address
RESEND_API_KEY=
FROM_EMAIL="BuddyAds <rohit@buddyads.agency>"
VISIBILITY_FROM_EMAIL="BuddyAds <rohit@buddyads.agency>"

# Local: http://localhost:3005 — Railway: your web service URL
PUBLIC_APP_URL=http://localhost:3005
VISIBILITY_PUBLIC_APP_URL=http://localhost:3005

WORKER_POLL_MS=5000
LLM_RESEARCH_CONCURRENCY=3
