# Use an absolute file path on Windows so web + worker share the same SQLite file.
DATABASE_URL="file:D:/Projects/BuddyAds-AI/prisma/dev.db"

# OpenRouter — paste your key (required for multi-LLM research + agent planner)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,anthropic/claude-3.5-haiku
AGENT_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://buddyads.agency
OPENROUTER_APP_TITLE=BuddyAds AI Visibility

# Resend — verify buddyads.agency domain, then use company from-address
RESEND_API_KEY=
FROM_EMAIL="BuddyAds <rohit@buddyads.agency>"
# Aliases (same meaning as AdGenix visibility env names)
VISIBILITY_FROM_EMAIL="BuddyAds <rohit@buddyads.agency>"

# Local: http://localhost:3005 — production: https://buddyads.agency
PUBLIC_APP_URL=http://localhost:3005
VISIBILITY_PUBLIC_APP_URL=http://localhost:3005

WORKER_POLL_MS=5000
AGENT_MAX_STEPS=12
LLM_RESEARCH_CONCURRENCY=3
