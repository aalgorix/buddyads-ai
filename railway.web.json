{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm exec prisma generate --schema=prisma/schema.prisma && pnpm --filter @buddyads/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @buddyads/web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
